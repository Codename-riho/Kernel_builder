+
+#ifndef _BOEFFLA_WL_BLOCKER_H
+#define _BOEFFLA_WL_BLOCKER_H
+
+#include <linux/types.h>
+#include <linux/rcupdate.h>
+#include <linux/jump_label.h>
+
+#define BOEFFLA_WL_BLOCKER_VERSION	"1.2.0"
+
+#define LIST_WL_DEFAULT			"qcom_rx_wakelock;wlan;wlan_wow_wl;wlan_extscan_wl;netmgr_wl;NETLINK"
+
+#define LENGTH_LIST_WL			255
+#define LENGTH_LIST_WL_DEFAULT		100
+
+/* wakeup source names longer than this are never matched */
+#define WL_MAX_NAME			50
+
+struct wl_blocker_entry {
+	unsigned char len;
+	char name[WL_MAX_NAME + 1];
+};
+
+/* immutable once published; replaced as a whole via RCU */
+struct wl_blocker_list {
+	struct rcu_head rcu;
+	unsigned int count;
+	struct wl_blocker_entry e[];
+};
+
+/* defined in wakeup.c, managed by boeffla_wl_blocker.c */
+DECLARE_STATIC_KEY_FALSE(wl_blocker_key);
+extern struct wl_blocker_list __rcu *wl_blocker_current;
+extern bool wl_blocker_debug;
+
+#endif /* _BOEFFLA_WL_BLOCKER_H */
