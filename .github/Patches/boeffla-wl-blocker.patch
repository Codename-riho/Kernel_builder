--- /dev/null
+++ b/drivers/base/power/boeffla_wl_blocker.c
@@ -0,0 +1,356 @@
+/*
+ * Author: andip71, 01.09.2017
+ *
+ * Version 1.2.0
+ *
+ * This software is licensed under the terms of the GNU General Public
+ * License version 2, as published by the Free Software Foundation, and
+ * may be copied, distributed, and modified under those terms.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ */
+
+/*
+ * Change log:
+ *
+ * 1.2.0
+ *   - Wakelock lists are parsed once (on write) into an RCU protected table;
+ *     the wakeup hot path no longer does sprintf()/strstr() and is a single
+ *     static-key branch while the list is empty
+ *   - Fix off-by-one buffer overflow in check (name buffer too small) and in
+ *     the sysfs stores (a list of exactly the maximum length overflowed)
+ *   - Never deactivate a wakeup source without holding its lock
+ *     (pm_print_active_wakeup_sources path now only matches)
+ *   - Serialize list updates, check misc_register()/sysfs errors, clean exit
+ *   - read-only version attribute, 0644 debug attribute
+ *
+ * 1.1.0 (01.09.2017)
+ *   - By default, the following wakelocks are blocked in an own list
+ *     qcom_rx_wakelock, wlan, wlan_wow_wl, wlan_extscan_wl, NETLINK
+ *
+ * 1.0.1 (29.08.2017)
+ *   - Add killing wakelock when currently active
+ *
+ * 1.0.0 (28.08.2017)
+ *   - Initial version
+ *
+ */
+
+#define pr_fmt(fmt) "Boeffla WL blocker: " fmt
+
+#include <linux/module.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/device.h>
+#include <linux/miscdevice.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include "boeffla_wl_blocker.h"
+
+
+/*****************************************/
+// Variables
+/*****************************************/
+
+static DEFINE_MUTEX(wl_lock);	/* protects both lists and publishing */
+static char list_wl[LENGTH_LIST_WL + 1];
+static char list_wl_default[LENGTH_LIST_WL_DEFAULT + 1];
+
+
+/*****************************************/
+// internal functions
+/*****************************************/
+
+/* next non-empty ';' separated token; returns false at end of string */
+static bool wl_next_token(const char **p, const char **tok, size_t *len)
+{
+	const char *s = *p;
+
+	while (*s == ';')
+		s++;
+	if (!*s) {
+		*p = s;
+		return false;
+	}
+
+	*tok = s;
+	*len = strcspn(s, ";");
+	*p = s + *len;
+	return true;
+}
+
+static unsigned int wl_count_tokens(const char *s)
+{
+	const char *tok;
+	size_t len;
+	unsigned int n = 0;
+
+	while (wl_next_token(&s, &tok, &len))
+		if (len <= WL_MAX_NAME)
+			n++;
+	return n;
+}
+
+static void wl_fill_tokens(struct wl_blocker_list *list, const char *s)
+{
+	const char *tok;
+	size_t len;
+
+	while (wl_next_token(&s, &tok, &len)) {
+		if (len > WL_MAX_NAME)
+			continue;	/* can never match a wakeup source name */
+		memcpy(list->e[list->count].name, tok, len);
+		list->e[list->count].name[len] = '\0';
+		list->e[list->count].len = len;
+		list->count++;
+	}
+}
+
+/*
+ * Build a new lookup table from user + default list and publish it.
+ * Must be called with wl_lock held. On error the old table stays active.
+ */
+static int wl_rebuild(const char *user, const char *deflt)
+{
+	struct wl_blocker_list *new_list = NULL, *old_list;
+	unsigned int n = wl_count_tokens(user) + wl_count_tokens(deflt);
+
+	if (n) {
+		new_list = kzalloc(sizeof(*new_list) +
+				   n * sizeof(new_list->e[0]), GFP_KERNEL);
+		if (!new_list)
+			return -ENOMEM;
+		wl_fill_tokens(new_list, deflt);
+		wl_fill_tokens(new_list, user);
+	}
+
+	old_list = rcu_dereference_protected(wl_blocker_current,
+					     lockdep_is_held(&wl_lock));
+	rcu_assign_pointer(wl_blocker_current, new_list);
+
+	/* flag for the hot path (idempotent, may sleep: process context only) */
+	if (new_list)
+		static_branch_enable(&wl_blocker_key);
+	else
+		static_branch_disable(&wl_blocker_key);
+
+	if (old_list)
+		kfree_rcu(old_list, rcu);
+
+	return 0;
+}
+
+/* store a list: validates length, rebuilds table, then commits the string */
+static ssize_t wl_store_list(char *dst, size_t dst_size, bool is_default,
+			     const char *buf, size_t n)
+{
+	size_t len = strcspn(buf, "\n");
+	char tmp[LENGTH_LIST_WL + 1];
+	int ret;
+
+	/* dst_size includes the terminating NUL */
+	if (len >= dst_size)
+		return -EINVAL;
+
+	memcpy(tmp, buf, len);
+	tmp[len] = '\0';
+
+	mutex_lock(&wl_lock);
+	ret = wl_rebuild(is_default ? list_wl : tmp,
+			 is_default ? tmp : list_wl_default);
+	if (!ret)
+		strscpy(dst, tmp, dst_size);
+	mutex_unlock(&wl_lock);
+
+	return ret ? ret : n;
+}
+
+
+/*****************************************/
+// sysfs interface functions
+/*****************************************/
+
+// show list of user configured wakelocks
+static ssize_t wakelock_blocker_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	ssize_t ret;
+
+	mutex_lock(&wl_lock);
+	ret = scnprintf(buf, PAGE_SIZE, "%s\n", list_wl);
+	mutex_unlock(&wl_lock);
+	return ret;
+}
+
+
+// store list of user configured wakelocks
+static ssize_t wakelock_blocker_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t n)
+{
+	return wl_store_list(list_wl, sizeof(list_wl), false, buf, n);
+}
+
+
+// show list of default, predefined wakelocks
+static ssize_t wakelock_blocker_default_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	ssize_t ret;
+
+	mutex_lock(&wl_lock);
+	ret = scnprintf(buf, PAGE_SIZE, "%s\n", list_wl_default);
+	mutex_unlock(&wl_lock);
+	return ret;
+}
+
+
+// store list of default, predefined wakelocks
+static ssize_t wakelock_blocker_default_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t n)
+{
+	return wl_store_list(list_wl_default, sizeof(list_wl_default), true, buf, n);
+}
+
+
+// show debug information of driver internals
+static ssize_t debug_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	ssize_t ret;
+
+	mutex_lock(&wl_lock);
+	ret = scnprintf(buf, PAGE_SIZE,
+			"Debug status: %d\n\nUser list: %s\nDefault list: %s\nSearch list: ;%s;%s;\nActive: %d\n",
+			wl_blocker_debug, list_wl, list_wl_default,
+			list_wl_default, list_wl,
+			static_branch_unlikely(&wl_blocker_key));
+	mutex_unlock(&wl_lock);
+	return ret;
+}
+
+
+// store debug mode on/off (1/0)
+static ssize_t debug_store(struct device *dev, struct device_attribute *attr,
+						const char *buf, size_t count)
+{
+	bool val;
+
+	if (kstrtobool(buf, &val))
+		return -EINVAL;
+
+	wl_blocker_debug = val;
+
+	return count;
+}
+
+
+static ssize_t version_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	// return version information
+	return scnprintf(buf, PAGE_SIZE, "%s\n", BOEFFLA_WL_BLOCKER_VERSION);
+}
+
+
+
+/*****************************************/
+// Initialize sysfs objects
+/*****************************************/
+
+// define objects
+static DEVICE_ATTR(wakelock_blocker, 0644, wakelock_blocker_show, wakelock_blocker_store);
+static DEVICE_ATTR(wakelock_blocker_default, 0644, wakelock_blocker_default_show, wakelock_blocker_default_store);
+static DEVICE_ATTR(debug, 0644, debug_show, debug_store);
+static DEVICE_ATTR(version, 0444, version_show, NULL);
+
+// define attributes
+static struct attribute *boeffla_wl_blocker_attributes[] = {
+	&dev_attr_wakelock_blocker.attr,
+	&dev_attr_wakelock_blocker_default.attr,
+	&dev_attr_debug.attr,
+	&dev_attr_version.attr,
+	NULL
+};
+
+// define attribute group
+static struct attribute_group boeffla_wl_blocker_control_group = {
+	.attrs = boeffla_wl_blocker_attributes,
+};
+
+// define control device
+static struct miscdevice boeffla_wl_blocker_control_device = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "boeffla_wakelock_blocker",
+};
+
+
+/*****************************************/
+// Driver init and exit functions
+/*****************************************/
+
+static int boeffla_wl_blocker_init(void)
+{
+	int ret;
+
+	// initialize default list first, so blocking works even without sysfs
+	mutex_lock(&wl_lock);
+	strscpy(list_wl_default, LIST_WL_DEFAULT, sizeof(list_wl_default));
+	ret = wl_rebuild(list_wl, list_wl_default);
+	mutex_unlock(&wl_lock);
+	if (ret)
+		pr_err("failed to build default wakelock list (%d)\n", ret);
+
+	// register boeffla wakelock blocker control device
+	ret = misc_register(&boeffla_wl_blocker_control_device);
+	if (ret) {
+		pr_err("failed to register misc device (%d)\n", ret);
+		return ret;
+	}
+
+	ret = sysfs_create_group(&boeffla_wl_blocker_control_device.this_device->kobj,
+				&boeffla_wl_blocker_control_group);
+	if (ret < 0) {
+		pr_err("failed to create sys fs object (%d)\n", ret);
+		misc_deregister(&boeffla_wl_blocker_control_device);
+		return ret;
+	}
+
+	// Print debug info
+	pr_info("driver version %s started\n", BOEFFLA_WL_BLOCKER_VERSION);
+
+	return 0;
+}
+
+
+static void boeffla_wl_blocker_exit(void)
+{
+	struct wl_blocker_list *old_list;
+
+	// remove boeffla wakelock blocker control device
+	sysfs_remove_group(&boeffla_wl_blocker_control_device.this_device->kobj,
+			   &boeffla_wl_blocker_control_group);
+	misc_deregister(&boeffla_wl_blocker_control_device);
+
+	// stop blocking and release the table
+	mutex_lock(&wl_lock);
+	static_branch_disable(&wl_blocker_key);
+	old_list = rcu_dereference_protected(wl_blocker_current,
+					     lockdep_is_held(&wl_lock));
+	rcu_assign_pointer(wl_blocker_current, NULL);
+	mutex_unlock(&wl_lock);
+	if (old_list)
+		kfree_rcu(old_list, rcu);
+
+	// Print debug info
+	pr_info("driver stopped\n");
+}
+
+
+/* define driver entry points */
+module_init(boeffla_wl_blocker_init);
+module_exit(boeffla_wl_blocker_exit);
