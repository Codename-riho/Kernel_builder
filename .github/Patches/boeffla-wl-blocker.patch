+#endif
+
 /*
  * If set, the suspend/hibernate code will abort transitions to a sleep state
  * if wakeup events are registered during or immediately before the transition.
@@ -613,6 +624,67 @@
 	trace_wakeup_source_activate(ws->name, cec);
 }
 
+#ifdef CONFIG_BOEFFLA_WL_BLOCKER
+/* Is the wakeup source on the blocker list? (no side effects) */
+static bool wl_blocker_match(const struct wakeup_source *ws)
+{
+	const struct wl_blocker_list *list;
+	size_t len;
+	unsigned int i;
+	bool hit = false;
+
+	if (!ws || !ws->name)
+		return false;
+
+	len = strlen(ws->name);
+	if (len < 1 || len > WL_MAX_NAME)
+		return false;
+
+	rcu_read_lock();
+	list = rcu_dereference(wl_blocker_current);
+	if (list) {
+		for (i = 0; i < list->count; i++) {
+			if (list->e[i].len == len &&
+			    !memcmp(list->e[i].name, ws->name, len)) {
+				hit = true;
+				break;
+			}
+		}
+	}
+	rcu_read_unlock();
+
+	return hit;
+}
+
+/*
+ * Called with ws->lock held. Blocks (and kills, if currently active) a
+ * wakeup source that is on the list. Cheap no-op while the list is empty.
+ */
+static bool check_for_block(struct wakeup_source *ws)
+{
+	if (unlikely(wl_blocker_debug) && ws && ws->name)
+		pr_info("Boeffla WL blocker: %s requested\n", ws->name);
+
+	if (!static_branch_unlikely(&wl_blocker_key))
+		return false;
+
+	if (!wl_blocker_match(ws))
+		return false;
+
+	if (unlikely(wl_blocker_debug))
+		pr_info("Boeffla WL blocker: %s blocked\n", ws->name);
+
+	if (ws->active) {
+		wakeup_source_deactivate(ws);
+
+		if (unlikely(wl_blocker_debug))
+			pr_info("Boeffla WL blocker: %s killed\n", ws->name);
+	}
+
+	return true;
+}
+#endif
+
