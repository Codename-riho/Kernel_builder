diff --git a/kernel/manager/manager_identity.h b/kernel/manager/manager_identity.h
index 1268f44..e833586 100644
--- a/kernel/manager/manager_identity.h
+++ b/kernel/manager/manager_identity.h
@@ -1,11 +1,20 @@
 #ifndef __KSU_H_MANAGER_IDENTITY
 #define __KSU_H_MANAGER_IDENTITY
 
+#include <linux/compiler.h>
 #include <linux/cred.h>
+#include <linux/sched.h>
 #include <linux/types.h>
 
 #define KSU_INVALID_APPID -1
 #define KSU_PER_USER_RANGE 100000
+// Multi-manager: at most KSU_MAX_MANAGERS verified managers are active at once.
+// Every manager has full root control, so the limit is kept at 2.
+#define KSU_MAX_MANAGERS 2
+
+// Only real app UIDs can be crowned (FIRST_APPLICATION_UID..LAST_APPLICATION_UID)
+#define KSU_FIRST_APP_APPID 10000
+#define KSU_LAST_APP_APPID 19999
 
 #ifdef CONFIG_KSU_DISABLE_MANAGER
 static inline bool ksu_is_manager_appid_valid()
@@ -36,37 +45,144 @@ static inline void ksu_set_manager_appid(uid_t appid)
 static inline void ksu_invalidate_manager_uid()
 {
 }
+
+static inline bool ksu_add_manager_appid(uid_t appid)
+{
+    (void)appid;
+    return true;
+}
+
+static inline void ksu_remove_manager_appid(uid_t appid)
+{
+    (void)appid;
+}
+
+static inline uid_t ksu_manager_appid_at(int idx)
+{
+    (void)idx;
+    return KSU_INVALID_APPID;
+}
+
+static inline int ksu_manager_appid_count(void)
+{
+    return 1;
+}
 #else
-extern uid_t ksu_manager_appid; // DO NOT DIRECT USE
+// Slots are only written under throne_tracker_mutex; readers are lockless.
+extern uid_t ksu_manager_appids[KSU_MAX_MANAGERS]; // DO NOT DIRECT USE
 
-static inline bool ksu_is_manager_appid_valid()
+static inline uid_t ksu_manager_appid_at(int idx)
 {
-    return ksu_manager_appid != KSU_INVALID_APPID;
+    return READ_ONCE(ksu_manager_appids[idx]);
 }
 
-static inline bool is_manager()
+static inline int ksu_manager_appid_count(void)
 {
-    return unlikely(ksu_manager_appid == current_uid().val % KSU_PER_USER_RANGE);
+    int i, n = 0;
+
+    for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+        if (ksu_manager_appid_at(i) != KSU_INVALID_APPID)
+            n++;
+    }
+    return n;
+}
+
+static inline bool ksu_is_manager_appid_valid()
+{
+    return ksu_manager_appid_count() > 0;
 }
 
 static inline bool is_uid_manager(uid_t uid)
 {
-    return unlikely(ksu_manager_appid == uid % KSU_PER_USER_RANGE);
+    int i;
+
+#ifndef KSU_MANAGER_ALL_USERS
+    // Only the owner (user 0) counts: copies of a manager in secondary
+    // users / dual apps are not accepted
+    if (uid / KSU_PER_USER_RANGE != 0)
+        return false;
+#endif
+    for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+        uid_t appid = ksu_manager_appid_at(i);
+
+        if (appid != KSU_INVALID_APPID && appid == uid % KSU_PER_USER_RANGE)
+            return true;
+    }
+    return false;
+}
+
+// Driver call protection: every manager-only driver call goes through here.
+// Besides the uid match, the caller must be a plain app process: no kernel
+// thread and no uid switching (euid must equal uid).
+static inline bool is_manager()
+{
+    uid_t uid = current_uid().val;
+
+    if (!is_uid_manager(uid))
+        return false;
+    return !(current->flags & PF_KTHREAD) && current_euid().val == uid;
 }
 
+// First crowned manager (kept for callers that only know about one manager)
 static inline uid_t ksu_get_manager_appid()
 {
-    return ksu_manager_appid;
+    int i;
+
+    for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+        uid_t appid = ksu_manager_appid_at(i);
+
+        if (appid != KSU_INVALID_APPID)
+            return appid;
+    }
+    return KSU_INVALID_APPID;
 }
 
-static inline void ksu_set_manager_appid(uid_t appid)
+// Crown one more manager. Returns false when all slots are taken or appid is not an app uid.
+static inline bool ksu_add_manager_appid(uid_t appid)
 {
-    ksu_manager_appid = appid;
+    int i, free_slot = -1;
+
+    if (appid < KSU_FIRST_APP_APPID || appid > KSU_LAST_APP_APPID)
+        return false; // not an app uid (system/shared/isolated uids are never managers)
+
+    for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+        uid_t cur = ksu_manager_appid_at(i);
+
+        if (cur == appid)
+            return true; // already crowned
+        if (cur == KSU_INVALID_APPID && free_slot < 0)
+            free_slot = i;
+    }
+    if (free_slot < 0)
+        return false;
+    WRITE_ONCE(ksu_manager_appids[free_slot], appid);
+    return true;
+}
+
+static inline void ksu_remove_manager_appid(uid_t appid)
+{
+    int i;
+
+    for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+        if (ksu_manager_appid_at(i) == appid)
+            WRITE_ONCE(ksu_manager_appids[i], KSU_INVALID_APPID);
+    }
 }
 
 static inline void ksu_invalidate_manager_uid()
 {
-    ksu_manager_appid = KSU_INVALID_APPID;
+    int i;
+
+    for (i = 0; i < KSU_MAX_MANAGERS; i++)
+        WRITE_ONCE(ksu_manager_appids[i], KSU_INVALID_APPID);
+}
+
+// Old single-manager semantic: replace every crowned manager with this one
+static inline void ksu_set_manager_appid(uid_t appid)
+{
+    ksu_invalidate_manager_uid();
+    if (appid != KSU_INVALID_APPID)
+        ksu_add_manager_appid(appid);
 }
 #endif
 
