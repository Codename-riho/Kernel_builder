-				pr_info("KernelSU: matched manager APK: %s (size=0x%x, hash=%s)\n",
-					path, size, hash);
-				return true;
-			}
+		if (parse_manager_list_entry(&p, &size, entry)) {
+			(void)size;
+			if (memcmp(digest, entry, SHA256_DIGEST_SIZE) == 0)
+				return true;
 		}
 
-		p = strchr(p, ',');
-		if (!p)
-			break;
-		p++; // skip comma
+		if (*p == ',')
+			p++;
+	}
