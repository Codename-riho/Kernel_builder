+# Multi-manager: all signatures above are trusted; default cap is 8 concurrent managers.
+# Optional build flags: KSU_MAX_MANAGERS=<n>, KSU_MANAGER_OWNER_ONLY=1
+ifdef KSU_MAX_MANAGERS
+ccflags-y += -DKSU_MAX_MANAGERS=$(KSU_MAX_MANAGERS)
+$(info -- KernelSU-Next Max Managers: $(KSU_MAX_MANAGERS))
