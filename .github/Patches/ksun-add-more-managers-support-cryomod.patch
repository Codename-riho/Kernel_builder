 static DEFINE_MUTEX(throne_tracker_mutex);
 
-uid_t ksu_manager_appid = KSU_INVALID_APPID;
+#ifndef CONFIG_KSU_DISABLE_MANAGER
+uid_t ksu_manager_appids[KSU_MAX_MANAGERS] = { [0 ... KSU_MAX_MANAGERS - 1] = KSU_INVALID_APPID };
+#endif
+
+#ifndef KSU_MANAGER_PACKAGE
+// number of packages seen by the last track_throne() run, used to decide when to rescan
+static size_t last_pkg_count;
+#endif
 
 #define DATA_PATH_LEN 384 // 384 is enough for /data/app/<package>/base.apk
 
@@ -70,7 +77,8 @@ static void crown_manager(const char *apk, struct list_head *uid_data)
 	list_for_each_entry (np, list, list) {
 		if (strncmp(np->package, target_pkg, KSU_MAX_PACKAGE_NAME) == 0) {
 			pr_info("Crowning manager: %s(uid=%d)\n", target_pkg, np->uid);
-			ksu_set_manager_appid(np->uid);
+			if (!ksu_add_manager_appid(np->uid))
+				pr_warn("cannot crown %s: no free manager slot or not an app uid\n", target_pkg);
 			break;
 		}
 	}
@@ -237,9 +245,11 @@ static void search_manager(const char *path, int depth, struct list_head *uid_da
 			if (unlikely(!is_manager))
 				goto skip_iterate;
 
-			// Verified manager found, halt outer loop
-			stop = 1;
+			// Verified manager found: crown it, but keep scanning so that
+			// every other verified manager gets crowned too
 			crown_manager(candidate_path, uid_data);
+			if (ksu_manager_appid_count() >= KSU_MAX_MANAGERS)
+				stop = 1;
 
 		skip_iterate:
 			list_del(&pos->list);
@@ -346,6 +356,7 @@ static void track_throne_function(bool prune_only)
 	if (prune_only)
 		goto prune;
 
+#ifdef KSU_MANAGER_PACKAGE
 	// first, check if manager_uid exist!
 	uid_t manager_package_uid = KSU_INVALID_APPID;
 	bool need_rescan = false;
@@ -412,6 +423,52 @@ static void track_throne_function(bool prune_only)
 		pr_info("Search manager finished\n");
 	}
 
+#else
+	// Multi-manager: several verified managers can be crowned at once.
+	// first, drop crowned managers whose package no longer exists
+	bool need_rescan = false;
+	size_t pkg_count = 0;
+	int i;
+
+	list_for_each_entry (np, &uid_list, list)
+		pkg_count++;
+
+	for (i = 0; i < KSU_MAX_MANAGERS; i++) {
+		uid_t appid = ksu_manager_appid_at(i);
+		bool found = false;
+
+		if (appid == KSU_INVALID_APPID)
+			continue;
+		list_for_each_entry (np, &uid_list, list) {
+			if (np->uid == appid) {
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			pr_info("manager uid %u is uninstalled, invalidate it!\n", appid);
+			ksu_remove_manager_appid(appid);
+		}
+	}
+
+	if (!ksu_is_manager_appid_valid()) {
+		// nothing crowned: look for a manager
+		need_rescan = true;
+	} else if (ksu_manager_appid_count() < KSU_MAX_MANAGERS && pkg_count > last_pkg_count) {
+		// a new package appeared and there is a free slot: it may be another manager
+		need_rescan = true;
+	} else {
+		pr_info("managers unchanged, skip search!\n");
+	}
+	last_pkg_count = pkg_count;
+
+	if (need_rescan) {
+		pr_info("Searching managers...\n");
+		search_manager("/data/app", 2, &uid_list);
+		pr_info("Search manager finished\n");
+	}
+#endif
+
 prune:
 	// then prune the allowlist
 	ksu_prune_allowlist(is_uid_exist, &uid_list);
