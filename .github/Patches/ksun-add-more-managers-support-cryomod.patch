+bool is_manager_apk(char *path)
+{
+	unsigned char *cert;
+	unsigned int cert_size = 0;
+	unsigned char digest[SHA256_DIGEST_SIZE];
+
+	cert = kmalloc(CERT_MAX_LENGTH, GFP_KERNEL);
+	if (!cert)
+		return false;
+
+	// Read and hash the certificate once, then compare against the cached list.
+	if (!get_v2_certificate(path, cert, &cert_size)) {
+		pr_debug("KernelSU: cannot read v2 cert from %s\n", path);
+		kfree(cert);
+		return false;
+	}
+	if (ksu_sha256(cert, cert_size, digest) != 0) {
+		pr_debug("KernelSU: sha256 failed for cert in %s\n", path);
+		kfree(cert);
+		return false;
+	}
+	if (manager_list_matches(digest)) {
+		pr_info("KernelSU: matched manager APK: %s (cert_size=%u)\n",
+			path, cert_size);
+		kfree(cert);
+		return true;
+	}
+#ifdef CONFIG_KSU_DEBUG
+	{
+		char hash_str[SHA256_DIGEST_SIZE * 2 + 1];
+
+		bin2hex(hash_str, digest, SHA256_DIGEST_SIZE);
+		hash_str[SHA256_DIGEST_SIZE * 2] = '\0';
+		pr_debug("KernelSU: APK %s cert sha256=%s (cert_size=%u) NO MATCH\n",
+			 path, hash_str, cert_size);
+	}
+#endif
+	kfree(cert);
-	}
-
 	return false;
