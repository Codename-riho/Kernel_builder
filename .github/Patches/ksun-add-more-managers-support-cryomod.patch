+static DEFINE_MUTEX(manager_hash_cache_lock);
+static u8 trusted_manager_hashes[KSU_MAX_TRUSTED_MANAGERS][SHA256_DIGEST_SIZE];
+static int trusted_manager_hash_count;
+static bool trusted_manager_hashes_ready;
+static bool trusted_manager_hashes_complete;
+
+static int hex_val(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+static bool parse_hex_uint(const char **pp, unsigned int *out)
+{
+	const char *p = *pp;
+	unsigned int value = 0;
+	int digits = 0;
+
+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
+		p += 2;
+
+	for (;;) {
+		int d = hex_val(*p);
+
+		if (d < 0)
+			break;
+		value = (value << 4) | d;
+		digits++;
+		p++;
+	}
+
+	if (!digits)
+		return false;
+
+	*pp = p;
+	*out = value;
+	return true;
+}
+
+// Parse one "<hex size>:<sha256>" entry from KSU_NEXT_MANAGER_LIST into a raw
+// 32-byte digest. Malformed entries are skipped instead of aborting the list.
+static bool parse_manager_list_entry(const char **pp, unsigned int *size_out, u8 *digest_out)
+{
+	const char *p = *pp;
+
+	while (*p) {
+		unsigned int size;
+		int i;
+
+		while (*p == ' ' || *p == '\t' || *p == ',')
+			p++;
+		if (!*p)
+			break;
+
+		if (!parse_hex_uint(&p, &size))
+			goto next;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (*p != ':')
+			goto next;
+		p++;
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		for (i = 0; i < SHA256_DIGEST_SIZE; i++) {
+			int hi = hex_val(p[i * 2]);
+			int lo;
+
+			if (hi < 0)
+				break;
+			lo = hex_val(p[i * 2 + 1]);
+			if (lo < 0)
+				break;
+			digest_out[i] = (hi << 4) | lo;
+		}
+		if (i != SHA256_DIGEST_SIZE)
+			goto next;
+
+		p += SHA256_DIGEST_SIZE * 2;
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (*p && *p != ',')
+			goto next;
+
+		*size_out = size;
+		*pp = p;
+		return true;
+
+next:
+		while (*p && *p != ',')
+			p++;
+		if (*p == ',')
+			p++;
+	}
+
+	*pp = p;
+	return false;
+}
+
+static void ensure_manager_hash_cache(void)
+{
+	const char *p;
+	int count = 0;
+	bool complete = true;
+
+	if (READ_ONCE(trusted_manager_hashes_ready)) {
+		smp_rmb();
+		return;
+	}
+
+	mutex_lock(&manager_hash_cache_lock);
+	if (trusted_manager_hashes_ready) {
+		mutex_unlock(&manager_hash_cache_lock);
+		return;
+	}
+
+	p = KSU_NEXT_MANAGER_LIST;
+	while (*p) {
+		unsigned int size;
+		u8 entry[SHA256_DIGEST_SIZE];
+
+		if (!parse_manager_list_entry(&p, &size, entry))
+			break;
+		(void)size;
+		if (count < KSU_MAX_TRUSTED_MANAGERS) {
+			memcpy(trusted_manager_hashes[count++], entry, SHA256_DIGEST_SIZE);
+		} else {
+			complete = false;
+			break;
+		}
+	}
+
+	trusted_manager_hash_count = count;
+	trusted_manager_hashes_complete = complete;
+	smp_wmb();
+	WRITE_ONCE(trusted_manager_hashes_ready, true);
+	mutex_unlock(&manager_hash_cache_lock);
+}
+
+static bool manager_list_matches(const u8 *digest)
 {
 	const char *p = KSU_NEXT_MANAGER_LIST;
+	u8 entry[SHA256_DIGEST_SIZE];
+	int i;
 
+	ensure_manager_hash_cache();
+	for (i = 0; i < trusted_manager_hash_count; i++) {
+		if (memcmp(digest, trusted_manager_hashes[i], SHA256_DIGEST_SIZE) == 0)
+			return true;
+	}
+	if (trusted_manager_hashes_complete)
+		return false;
+
 	while (*p) {
 		unsigned int size;
-		char hash[65] = {0};
 
-		if (sscanf(p, "%x:%64[^,]", &size, hash) == 2) {
